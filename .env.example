# Copie para .env local. Valores reais nunca entram no Git.
N8N_HOST=n8n.example.com
EVOLUTION_HOST=evolution.example.com
N8N_ENCRYPTION_KEY=
REDIS_PASSWORD=
EVOLUTION_API_KEY=
POSTGRES_PASSWORD=
# URI real: postgresql://USUARIO:SENHA_CODIFICADA@postgres:5432/BANCO
# Deve corresponder ao banco/usuário/senha já existentes no PostgreSQL.
EVOLUTION_DATABASE_CONNECTION_URI=

# Nomes presentes no .env recebido, mas não repassados aos serviços pelo
# Compose atual. Tokens das integrações devem ser configurados nas
# credenciais do n8n. N8N_USER/PASSWORD não configuram o login do n8n 2.x.
N8N_USER=
N8N_PASSWORD=
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
NEWS_API_KEY=
ALPHA_VANTAGE_KEY=
