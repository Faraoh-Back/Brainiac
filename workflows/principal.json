    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Formato real da Evolution API\nconst body = input.body?.data ? input.body : input.body?.body;\n\nconst msg = body?.data?.message;\nconst from = body?.data?.key?.remoteJid?.replace('@s.whatsapp.net', '');\nconst fromMe = body?.data?.key?.fromMe;\n\nif (fromMe) return [];\nif (!from) return [];\n\nconst text = msg?.conversation \n  || msg?.extendedTextMessage?.text \n  || msg?.imageMessage?.caption\n  || msg?.documentMessage?.caption\n  || '';\n\nconst MEU_NUMERO = 'CONFIGURAR_NUMERO_WHATSAPP';\n\nreturn [{\n  json: {\n    from,\n    text,\n    isAudio: !!msg?.audioMessage,\n    timestamp: new Date().toISOString(),\n    id: Date.now().toString(),\n    data: new Date().toLocaleDateString('pt-BR', {timeZone: 'America/Sao_Paulo'}),\n    isMeu: from === MEU_NUMERO,\n  }\n}];"
      },
      "id": "b73bcefa-f5eb-45a2-abb7-4780f79c7059",
      "name": "Extrair Dados",
      "type": "n8n-nodes-base.code",
